// Config file for processing SuRE data for SVs

// Set conda environment for R
conda.enabled = true
process {
    conda = "$baseDir/envs/environment.yml"
}

// Settings for cluster resources
process	{
	withLabel: single_cpu_job	{
		cpus = 1
		memory = 8.GB
	}
}

process	{
	withLabel: small_job	{
		cpus = 2
		memory = 24.GB
	}
}

process {
	withLabel: medium_job_increasing	{
		cpus = { 4 + task.attempt * 2 }
		memory = { 24.GB * task.cpus }
		errorStrategy = 'retry'
		maxRetries = 3
	}
}

process {
	withLabel: normdata	{
		cpus = { 6 + task.attempt * 2 }
		memory = { 24.GB * task.cpus }
		errorStrategy = 'retry'
		maxRetries = 3
	}
}


process {
	withLabel: big_job_increasing	{
		cpus = { 7 + task.attempt }
		memory = { 32.GB * task.cpus }
		errorStrategy = 'retry'
		maxRetries = 3
	}
}

process	{
	withLabel: models	{
		cpus = { params.modelCores + task.attempt - 1 }
		memory = { 32.GB * task.cpus }
		errorStrategy = 'retry'
		maxRetries = 3
	}
}

process	{
	withLabel: models_multi	{
		cpus = { params.modelCores + task.attempt * 2 }
		memory = { 32.GB * task.cpus }
		errorStrategy = 'retry'
		maxRetries = 3
	}
}
