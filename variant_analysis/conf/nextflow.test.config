// Config file for processing SuRE data for SVs

// Set conda environment for R
conda.enabled = true
process {
    conda = "$baseDir/envs/environment.yml"
}

// Settings for cluster resources
process	{
	withLabel: single_cpu_job	{
		cpus = 1
		memory = 8.GB
	}
}

process {
	withLabel: big_job_increasing	{
		cpus = { task.attempt }
		memory = { 24.GB * task.cpus }
	}
}


process {
	withLabel: medium_job_increasing	{
		cpus = { task.attempt }
		memory = { 24.GB * task.cpus }
	}
}


process	{
	withLabel: models	{
		cpus = params.modelCores
		memory = { 8.GB * task.cpus }
	}
}
