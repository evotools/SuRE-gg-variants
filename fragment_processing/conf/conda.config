// Settings for tools to use via conda

process	{
	
	withLabel: cutadapt {
		conda = 'bioconda::cutadapt=4.6'
	}
	withName: FASTPQC {
		conda = 'bioconda::fastqc bioconda::fastp'
	}
	withLabel: bowtie {
		conda = 'bioconda::bowtie2 bioconda::samtools conda-forge::ncurses'
	}
	withLabel: bcftools {
		conda = 'bioconda::bcftools conda-forge::ncurses'
	}
	withName: SPLIT_FASTQ	{
		conda = 'bioconda::seqkit'
	}
}