// Detailed parameters for various processing steps that don't vary between libraries

// Parameters for read trimming
params	{
	adapterF	= 'CCTAGCTAACTATAACGGTCCTAAGGTAGCGAACCAGTGAT'
	adapterR	= 'CCAGTCGT'
	minsize	= 6
	cDNAadapterF = 'CCTAGCTAACTATAACGGTCCTAAGGTAGCGAA'
}

// Parameters for read parsing
//params.gawk = 'gawk' // If gawk not available, change this and add to calls to scripts that need it (in processes IPCR_BAM, IPCR_GAM, MERGE_IPCR, COUNTBARCODE, MERGE_IPCR_CDNA, AGG_COUNTS)

// Parameters for where to publish output (usually with symbolic links). These will be created/expected within the results directory given by the input file
// outIpcrTable, outCountsTables and outAln are within a directory given by another parameter, refName
params	{
	outIpcrTrim = 'iPCR_trim'			// trimmed iPCR reads and info files
	outIpcrTable = 'iPCR_tables'			// files of details of fragments from iPCR
	outCdna = 'cDNA_counts'				// cDNA barcode counts (trimmed reads and input files not published)
	outAln = 'alignments'				// alignments and stats files (aligner implicit in reference name parent directory)
	outCountsTables = 'counts_tables'
	outVarCounts = 'var_counts_tables'	// counts tables of fragments containing variants, with variant details
	outBatchStats = 'intermediate_stats'	// various stats/summary files for checking
}