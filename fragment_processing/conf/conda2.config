// Settings for tools to use via conda

process	{
	
	withLabel: cutadapt {
		conda = 'bioconda::cutadapt=4.6'
	}
	withLabel: bowtie {
		conda = 'bioconda::bowtie2 bioconda::samtools conda-forge::ncurses'
	}
	withLabel: samtools {
		conda = 'bioconda::samtools conda-forge::ncurses'
	}
	withLabel: bedgraph	{
		conda = 'bioconda::ucsc-bedgraphtobigwig'
	}
}