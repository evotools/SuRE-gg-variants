// Config file for processing SuRE data for SVs

// Get parameters
// Config
includeConfig './conf/params.config'

// Get conda settings
profiles {
	'conda'	{
		includeConfig 'conf/conda.config'
		conda.enabled = true
	}
	'conda2'	{
		includeConfig 'conf/conda2.config'
		conda.enabled = true
	}
	'conda_local'	{
		includeConfig 'conf/conda_local.config'
		conda.enabled = true
	}
}

// Settings for cluster resources

process	{
	withLabel: single_cpu_job	{
		cpus = 1
		memory = 8.GB
	}
}

process	{
	withLabel: small_job	{
		cpus = 4
		memory = 16.GB
	}
}

process	{
	withLabel: medium_job	{
		cpus = 8
		memory = 32.GB
	}
}

process	{
	withLabel: big_job	{
		cpus = 16
		memory = 128.GB
	}
}

process	{
	withLabel: giraffe	{
		cpus = 20
		memory = 256.GB
	}
}

// On Eddie for a single-thread process that requires a lot of memory (e.g. sorting) it is recommended to still request more cores with 8 GB memory rather than one core with high memory. This (16 cores, 128 GB) is the maximum available on standard nodes.
process {
	withLabel: highmem_job	{
		cpus = 16
		memory = 128.GB
	}
}

process {
	withLabel: highmem_short_job	{
		cpus = 16
		memory = 128.GB
		time = 29.minute
	}
}

